PORT=5000
# Only read by the one-off import (npm run db:import-mongo); the app itself no longer uses MongoDB.
MONGODB_URI=mongodb://127.0.0.1:27017/lms_db
JWT_SECRET=lms_jwt_secret_key_development_2026
JWT_REFRESH_SECRET=lms_jwt_refresh_secret_key_development_2026
CLIENT_URL=http://localhost:3000

# A payout above this is filed for Admin approval instead of being settled.
PAYOUT_SELF_APPROVE_LIMIT=5000
# A bill discount above this percent needs an Admin.
MAX_STAFF_DISCOUNT_PERCENT=20

# PostgreSQL (Prisma). Create the database as UTF8 with the C collation - see migration/README.md.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lms_db?schema=public
