# Frontend Production Environment Variables
VITE_API_URL=http://localhost:5000/api


# ---------------------------------------------------------------------------
# The centre's letterhead - printed on every bill, doctor's copy and report.
# Anything left blank is simply not printed, so fill in what is real and leave
# the rest. The backend has the same list without the VITE_ prefix; set both.
# ---------------------------------------------------------------------------
VITE_CENTRE_NAME=
VITE_CENTRE_UNIT_LINE=
VITE_CENTRE_TAGLINE=
VITE_CENTRE_ADDRESS=
VITE_CENTRE_EMAIL=
VITE_CENTRE_WEBSITE=
VITE_CENTRE_PHONES=
VITE_CENTRE_MOBILES=
# The "call us about your report" number printed top-right on the bill.
VITE_CENTRE_ENQUIRY_NUMBERS=
VITE_CENTRE_PROCESSING_LAB=
# Only an accreditation the centre actually holds, e.g. NABL Accredited.
VITE_CENTRE_ACCREDITATION=
VITE_CENTRE_UPI_PAYEE=
VITE_CENTRE_COLLECTION_NOTE=
