{
  "name": "lms-backend",
  "version": "1.0.0",
  "description": "Laboratory Management System Backend API",
  "main": "dist/app.js",
  "scripts": {
    "dev": "nodemon src/app.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/app.js",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:import-mongo": "npx ts-node --transpile-only migration/mongo-to-postgres.ts",
    "db:verify-import": "npx ts-node --transpile-only migration/roundtrip-check.ts",
    "db:studio": "prisma studio",
    "db:view": "npx ts-node --transpile-only src/scripts/view-db.ts",
    "seed": "npx ts-node --transpile-only src/scripts/seed.ts",
    "migrate": "npx ts-node --transpile-only src/scripts/migrate-roles.ts",
    "backfill:parameters": "npx ts-node --transpile-only src/scripts/backfill-parameters.ts",
    "seed:tests": "npx ts-node --transpile-only src/scripts/seed-tests.ts",
    "seed:staff": "npx ts-node --transpile-only src/scripts/seed-staff.ts",
    "seed:checkup": "npx ts-node --transpile-only src/scripts/seed-full-body-checkup.ts",
    "list:patients": "npx ts-node --transpile-only src/scripts/list-patient-ids.ts",
    "backfill:enquiry": "npx ts-node --transpile-only src/scripts/backfill-enquiry-numbers.ts",
    "backfill:formulas": "npx ts-node --transpile-only src/scripts/backfill-formulas.ts",
    "fill:ranges": "npx ts-node --transpile-only src/scripts/fill-high-low-ranges.ts",
    "normalise:bands": "npx ts-node --transpile-only src/scripts/normalise-parameter-bands.ts",
    "set:ranges": "npx ts-node --transpile-only src/scripts/set-reference-ranges.ts",
    "test:workflow": "npx ts-node --transpile-only src/scripts/test-workflow.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@types/helmet": "^0.0.48",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "docxtemplater": "^3.71.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.16.0",
    "pizzip": "^3.3.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.13.4",
    "@types/pdfkit": "^0.13.9",
    "mongoose": "^8.10.1",
    "nodemon": "^3.1.9",
    "prisma": "^6.19.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
