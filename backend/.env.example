# Backend Production Environment Variables
PORT=5000
# PostgreSQL (Prisma). Create the database as UTF8 with the C collation - see migration/README.md.
DATABASE_URL=postgresql://<username>:<password>@<host>:5432/lms_db?schema=public
# Only read by the one-off import from MongoDB (npm run db:import-mongo); the app does not use it.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/lms_db?retryWrites=true&w=majority
JWT_SECRET=super_secret_jwt_key_production_32_chars_min
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_production_32_chars_min
# The site(s) the frontend is served from, comma-separated. Only these may call
# the API from a browser; localhost:3000/5173 are added outside production.
CLIENT_URL=http://localhost:3000
# production on a live server: hides internal error details from the browser
# and stops letting localhost in.
NODE_ENV=
# 1 when the server sits behind one proxy (Render, nginx), so rate limiting and
# the audit log see each client's own address.
TRUST_PROXY=
EMAIL_API_KEY=smtp_or_sendgrid_api_key_here
SMS_API_KEY=twilio_or_fast2sms_api_key_here
WHATSAPP_API_KEY=whatsapp_cloud_api_token_here


# ---------------------------------------------------------------------------
# The centre's letterhead for the downloadable PDF report. Mirror of the
# frontend's VITE_CENTRE_* values; blank lines are not printed.
# ---------------------------------------------------------------------------
CENTRE_NAME=
CENTRE_ADDRESS=
CENTRE_EMAIL=
CENTRE_PHONES=
CENTRE_MOBILES=
CENTRE_ENQUIRY_NUMBERS=
# Only an accreditation the centre actually holds, e.g. NABL Accredited.
CENTRE_ACCREDITATION=
# The logo drawn in the space the PDF letterhead keeps for it. Absolute, or
# relative to where the server runs - ../frontend/public/logo.png prints the
# same artwork the browser does. Unset, the space is left blank.
CENTRE_LOGO_PATH=
